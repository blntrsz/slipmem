{
  "name": "slipmem",
  "private": true,
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "effect": "^4.1.4",
      "drizzle-orm": "1.0.0-rc.5",
      "@effect/sql-sqlite-bun": "^4.1.4"
    }
  },
  "scripts": {
    "test": "bun test",
    "lint": "oxlint packages",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web/tsconfig.json",
    "check": "bun run lint && bun run typecheck && bun test && bun run web:build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "web": "bun run --cwd packages/web start",
    "web:build": "bun run --cwd packages/web build",
    "web:serve": "bun run --cwd packages/web serve"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "1.0.0-rc.5",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
